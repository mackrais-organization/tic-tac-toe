<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php" cacheDirectory="var/cache/phpunit"
         colors="true" failOnWarning="true" failOnRisky="true" failOnDeprecation="true"
         failOnPhpunitDeprecation="true" failOnNotice="true">
    <testsuites><testsuite name="unit"><directory>tests/Unit</directory></testsuite></testsuites>
    <source><include><directory suffix=".php">src</directory></include></source>
    <php><ini name="date.timezone" value="UTC"/><ini name="error_reporting" value="-1"/></php>
</phpunit>
