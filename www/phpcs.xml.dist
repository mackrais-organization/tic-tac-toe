<?xml version="1.0"?>
<ruleset name="TicTacToe">
    <description>PSR-12, aligned with PHP CS Fixer.</description>
    <file>src</file><file>tests</file><file>config</file><file>public</file>
    <arg name="extensions" value="php"/>
    <arg name="cache" value="var/cache/phpcs.cache"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
